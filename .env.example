# ==============================================================================
# CodeAlpha Hybrid AI Chatbot - Environment Configuration (.env.example)
# ==============================================================================

# LLM Provider Selection: "auto", "gemini", or "openai"
# - "auto"   : Uses Gemini if GEMINI_API_KEY is present; else OpenAI if OPENAI_API_KEY is present; else Smart Offline Mode.
# - "gemini" : Enforces Google Gemini provider.
# - "openai" : Enforces OpenAI provider.
LLM_PROVIDER=auto

# --- Google Gemini Configuration ---
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# --- OpenAI Configuration ---
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# --- NLP & FAQ Engine Settings ---
SIMILARITY_THRESHOLD=0.35
MAX_HISTORY_TURNS=8

# --- Flask Server Settings ---
PORT=5000
FLASK_DEBUG=false
